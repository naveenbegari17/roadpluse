# RoadPulse Environment Configuration Template
# Copy this file to .env for local overrides if needed.

# Flask Session Security Key
FLASK_SECRET_KEY=roadpulse_secure_demo_key_zero_cost

# Optional: Persistent Cloud PostgreSQL (e.g., Neon or Supabase free tier)
# If omitted or left blank, RoadPulse defaults to local zero-cost SQLite (roadpulse.db)
# DATABASE_URL=postgresql://user:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local SQLite Database Path override (Optional)
ROADPULSE_DB_PATH=roadpulse.db
